<?xml version="1.0"?>
<!-- generated by camhdmi/run.sh from rc.xml.in - edit the template, not this file -->
<labwc_config>
  <core><decoration>server</decoration><gap>0</gap></core>
  <theme><titlebar><layout></layout><showTitle>no</showTitle></titlebar></theme>
  <keyboard><default /></keyboard>
  <!-- the 7" touchscreen only covers the DSI panel, not the whole desktop -->
  <touch mapToOutput="DSI-1" mouseEmulation="yes" />
  <windowRules>
    <windowRule identifier="camhdmi-video" serverDecoration="no" skipTaskbar="yes">
      <action name="MoveToOutput" output="@HDMI@"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="se.camhdmi.panel" serverDecoration="no" skipTaskbar="yes">
      <action name="MoveToOutput" output="DSI-1"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
  </windowRules>
</labwc_config>
